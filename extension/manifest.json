{
  "manifest_version": 3,
  "name": "Frameway \u00b7 Walkthrough recorder",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Record tab video and clicks, then build a local interactive walkthrough.",
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Frameway: record or open projects",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/frameway-16.png",
      "32": "icons/frameway-32.png",
      "48": "icons/frameway-48.png",
      "128": "icons/frameway-128.png"
    }
  },
  "options_page": "index.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Frameway recording and projects menu"
    }
  },
  "icons": {
    "16": "icons/frameway-16.png",
    "32": "icons/frameway-32.png",
    "48": "icons/frameway-48.png",
    "128": "icons/frameway-128.png"
  }
}
