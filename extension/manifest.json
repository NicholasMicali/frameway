{
  "manifest_version": 3,
  "name": "Frameway \u00b7 Walkthrough recorder",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Record tab video and clicks, then build a local interactive walkthrough.",
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Frameway: start / stop recording"
  },
  "options_page": "index.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Start or stop walkthrough recording"
    }
  }
}
