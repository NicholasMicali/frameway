{
  "name": "frameway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "vite --host 127.0.0.1",
    "test": "node --import tsx --test tests/model.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:export": "node tests/export.mjs",
    "test:recording": "node tests/recording.mjs",
    "test:editor": "node tests/editor.mjs",
    "test:title": "node tests/title.mjs",
    "package:extension": "npm run build && node scripts/package-extension.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "fix-webm-duration": "^1.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "8.72.0",
    "esbuild": "^0.25.0",
    "eslint": "10.13.0",
    "playwright": "^1.58.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "Apache-2.0"
}
